{
  "name": "Auto-Map Product Emissions on Create",
  "description": "Automatically triggers the 4-tier emission mapping pipeline (UPC \u2192 Commodity \u2192 Climatiq \u2192 AI) when a new product is created, so future products get mapped without manual action.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Product"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_map_product_emissions_on_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoMapProductEmissions",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoMapProductEmissions"
  }
}